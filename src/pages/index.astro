---
import "../styles/global.css";

// ALL HERO TEXT LIVES HERE. Edit these lines when your work changes.
const hero = {
  headline: "I build AI systems and test them until they hold up.",
  intro:
    "I’m Paras, based in Gurugram. I build AI agents, evaluation pipelines and automation, and nothing is done until the numbers say so.",
};

// The conversation card. Swap the last answer whenever you ship a new project.
const call = [
  { who: "caller", text: "Hi. What does Paras build?" },
  {
    who: "site",
    text: "हाय! मैं Paras की website हूँ. He builds AI systems: agents, eval pipelines and automation.",
  },
  { who: "caller", text: "What’s the latest?" },
  {
    who: "site",
    text: "Nova: an AI agent with 40 test scenarios and an LLM judge. Critical pass rate went from 77.5% to 97.5%. More builds are on the way.",
  },
];

const barHeights = ["h-3", "h-5", "h-4", "h-6", "h-3"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Paras Sharma, AI systems built and tested</title>
    <meta
      name="description"
      content="Paras Sharma builds AI agents, evaluation pipelines and automation."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Hanken+Grotesk:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
      <a href="/" class="font-display text-lg font-semibold">Paras Sharma</a>
      <nav class="flex gap-6 text-sm font-medium text-dusk">
        <a href="#projects" class="hover:text-ink">Projects</a>
        <a href="#experience" class="hover:text-ink">Experience</a>
        <a href="#contact" class="hover:text-ink">Contact</a>
      </nav>
    </header>

    <main>
      <section
        class="mx-auto grid max-w-6xl gap-12 px-6 pt-10 pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pt-20"
      >
        <div>
          <h1
            class="font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl lg:text-7xl"
          >
            {hero.headline}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-dusk">
            {hero.intro}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#projects"
              class="rounded-full bg-marigold px-6 py-3 font-semibold text-ink hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              See projects
            </a>
            <a
              href="https://github.com/paras9706"
              class="rounded-full border border-ink/25 px-6 py-3 font-semibold hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              Open GitHub
            </a>
          </div>
        </div>