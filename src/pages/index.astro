---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// Projects come from src/content/projects/. Lowest "order" shows first.
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

// ALL HERO TEXT LIVES HERE. Edit these lines when your work changes.
const hero = {
  headline: "I build AI systems and test them until they hold up.",
  intro:
    "I’m Paras, based in Gurugram. I build AI agents, evaluation pipelines and automation, and nothing is done until the numbers say so.",
};

// The conversation card. Swap the last answer whenever you ship a new project.
const call = [
  { who: "caller", text: "Hi. What does Paras build?" },
  {
    who: "site",
    text: "हाय! मैं Paras की website हूँ. He builds AI systems: agents, eval pipelines and automation.",
  },
  { who: "caller", text: "What’s the latest?" },
  {
    who: "site",
    text: "Nova: an AI agent with 40 test scenarios and an LLM judge. Critical pass rate went from 77.5% to 97.5%. More builds are on the way.",
  },
];

const barHeights = ["h-3", "h-5", "h-4", "h-6", "h-3"];
---

<Base
  title="Paras Sharma, AI systems built and tested"
  description="Paras Sharma builds AI agents, evaluation pipelines and automation."
>
      <section
        class="mx-auto grid max-w-6xl gap-12 px-6 pt-10 pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pt-20"
      >
        <div>
          <h1
            class="font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl"
          >
            {hero.headline}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-dusk">
            {hero.intro}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#projects"
              class="rounded-full bg-marigold px-6 py-3 font-semibold text-ink hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              See projects
            </a>
            <a
              href="https://github.com/paras9706"
              class="rounded-full border border-ink/25 px-6 py-3 font-semibold hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              Open GitHub
            </a>
          </div>
        </div>
        <div
          class="rounded-3xl bg-white p-5 shadow-[0_24px_60px_-30px_rgba(27,31,75,0.45)] sm:p-6"
        >
          <div class="flex items-center gap-3 border-b border-ink/10 pb-4">
            <div class="flex h-6 items-center gap-1" aria-hidden="true">
              {
                barHeights.map((height, i) => (
                  <span
                    class:list={["bar w-1 rounded-full bg-marigold", height]}
                    style={`animation-delay:${i * 0.12}s`}
                  />
                ))
              }
            </div>
            <p class="text-sm font-medium text-dusk">
              Talking to Paras’s website
            </p>
          </div>

          <ol class="mt-5 space-y-3">
            {
              call.map((line, i) => (
                <li
                  class:list={[
                    "bubble flex",
                    line.who === "site" ? "justify-end" : "justify-start",
                  ]}
                  style={`--delay:${0.4 + i * 0.9}s`}
                >
                  <p
                    class:list={[
                      "max-w-[85%] rounded-2xl px-4 py-3 leading-relaxed",
                      line.who === "site"
                        ? "rounded-br-md bg-ink text-white"
                        : "rounded-bl-md bg-mist text-ink",
                    ]}
                  >
                    <span class="sr-only">
                      {line.who === "site" ? "Paras’s website: " : "Visitor: "}
                    </span>
                    {line.text}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="projects" class="mx-auto max-w-6xl scroll-mt-6 px-6 pb-24">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Projects
        </h2>

        <div class="mt-8 space-y-6">
          {
            projects.map((project) => (
              <article class="grid gap-8 rounded-3xl bg-white p-6 shadow-[0_24px_60px_-40px_rgba(27,31,75,0.45)] sm:p-8 lg:grid-cols-[1.2fr_0.8fr]">
                <div>
                  <h3 class="font-display text-2xl font-semibold">
                    {project.data.title}
                  </h3>
                  <p class="mt-3 max-w-xl text-lg leading-relaxed text-dusk">
                    {project.data.summary}
                  </p>
                  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Built with">
                    {project.data.stack.map((item) => (
                      <li class="rounded-full bg-mist px-3 py-1 text-sm font-medium">
                        {item}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                    <a
                      href={`/projects/${project.id}/`}
                      class="font-semibold underline decoration-marigold decoration-2 underline-offset-4 hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                    >
                      Read the case study <span aria-hidden="true">→</span>
                    </a>
                    {project.data.repo && (
                      <a
                        href={project.data.repo}
                        class="font-semibold underline decoration-marigold decoration-2 underline-offset-4 hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                      >
                        See the code on GitHub
                      </a>
                    )}
                  </div>
                </div>

                <dl class="space-y-5 lg:border-l lg:border-ink/10 lg:pl-8">
                  {project.data.results.map((result) => (
                    <div>
                      <dt class="text-sm font-medium text-dusk">
                        {result.label}
                      </dt>
                      <dd class="mt-1 flex items-baseline gap-3">
                        <span class="text-lg text-dusk">{result.before}</span>
                        <span class="text-marigold" aria-hidden="true">
                          →
                        </span>
                        <span class="sr-only">to</span>
                        <span class="font-display text-4xl font-bold">
                          {result.after}
                        </span>
                      </dd>
                    </div>
                  ))}
                </dl>
              </article>
            ))
          }
        </div>
      </section>
</Base>